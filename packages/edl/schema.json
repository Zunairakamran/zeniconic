{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeniconic.app/schema/edl-2.0.0.json",
  "title": "Zeniconic EDL",
  "description": "The single source of truth for one variant. A render is a pure function of an EDL plus its referenced media. Times are seconds (3dp), never frames. `edlVersion` accepts 1.0.0 (legacy, upgraded by migrateEdl) and 2.0.0. The schema enforces shape, closed enums, string formats and array limits; numeric ranges and cross-field rules (effects, grade, speed ramps, caption limits, effect windows) are enforced at runtime by validate.ts. Runtime validation additionally enforces: clip.outSec > clip.inSec; clips ordered and contiguous except for explicit gaps; sum of (outSec-inSec)/speed equals format.targetDurationSec within ±0.5s; every overlay interval inside the timeline; every clip.src resolves to an indexed source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["edlVersion", "id", "listingId", "createdAt", "format", "look", "canvas", "clips", "overlays", "audio", "captions", "provenance"],
  "properties": {
    "edlVersion": {
      "type": "string",
      "enum": ["1.0.0", "2.0.0"],
      "description": "1.0.0 documents are read-only legacy; writers migrate to 2.0.0."
    },
    "id": { "type": "string", "pattern": "^edl_[a-z0-9-]+_v[0-9]+$" },
    "listingId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "parentId": {
      "type": ["string", "null"],
      "description": "Previous EDL id this revision derives from; null for v1."
    },
    "format": { "$ref": "#/$defs/FormatRef" },
    "look": { "$ref": "#/$defs/LookRef" },
    "canvas": { "$ref": "#/$defs/Canvas" },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/Clip" }
    },
    "overlays": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/Overlay" }
    },
    "audio": { "$ref": "#/$defs/Audio" },
    "captions": { "$ref": "#/$defs/Captions" },
    "review": { "$ref": "#/$defs/Review" },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "output": {
      "$ref": "#/$defs/Output",
      "description": "v2: optional encode overrides. Bounds are enforced at runtime (E_OUTPUT_RANGE)."
    },
    "effects": {
      "type": "array",
      "maxItems": 20,
      "description": "v2: timeline-global effects, applied after per-clip effects.",
      "items": { "$ref": "#/$defs/Effect" }
    },
    "grade": {
      "$ref": "#/$defs/ColorGrade",
      "description": "v2: global grade, applied after the clip grade. Ranges are enforced at runtime (E_GRADE_RANGE)."
    }
  },
  "$defs": {
    "Profile": {
      "type": "string",
      "enum": ["vertical-social", "feed-portrait", "landscape", "pin"]
    },
    "SafeArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "bottom", "left", "right"],
      "description": "Pixels that must stay clear of text and logos.",
      "properties": {
        "top": { "type": "integer", "minimum": 0 },
        "bottom": { "type": "integer", "minimum": 0 },
        "left": { "type": "integer", "minimum": 0 },
        "right": { "type": "integer", "minimum": 0 }
      }
    },
    "Canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "width", "height", "fps", "safeArea"],
      "properties": {
        "profile": { "$ref": "#/$defs/Profile" },
        "width": { "type": "integer", "minimum": 240, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 240, "maximum": 4096 },
        "fps": { "type": "number", "minimum": 12, "maximum": 120 },
        "safeArea": { "$ref": "#/$defs/SafeArea" }
      }
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "description": "v2: encode overrides. Omitted fields fall back to the render profile. Ranges: width/height 320..7680, fps 12..60.",
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "number" },
        "videoBitrate": { "type": "string", "pattern": "^\\d+[kM]$" },
        "audioBitrate": { "type": "string", "pattern": "^\\d+k$" }
      }
    },
    "LutPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+\\.cube$",
      "maxLength": 240,
      "description": "Repo-relative .cube lookup table under data/luts/. No absolute paths and no '..' segments (enforced at runtime as E_LUT_PATH)."
    },
    "EffectType": {
      "type": "string",
      "enum": [
        "blur",
        "motion_blur",
        "glow",
        "grain",
        "vignette",
        "sharpen",
        "chromatic_aberration",
        "saturation",
        "exposure",
        "contrast",
        "lut",
        "stabilize"
      ]
    },
    "EffectParams": {
      "type": "object",
      "description": "Type-specific payload. Allowed keys and numeric bounds are enforced at runtime (E_EFFECT_PARAM / E_EFFECT_RANGE); unknown keys are rejected.",
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    },
    "Effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^e[0-9]{1,3}$" },
        "type": { "$ref": "#/$defs/EffectType" },
        "amount": { "type": "number", "description": "0..100 strength for types that have one (E_EFFECT_RANGE)." },
        "inSec": { "type": "number", "minimum": 0 },
        "outSec": { "type": "number", "minimum": 0 },
        "params": { "$ref": "#/$defs/EffectParams" },
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "GradePreset": {
      "type": "string",
      "enum": [
        "none",
        "warm_cinematic",
        "cool_cinematic",
        "luxury",
        "natural",
        "vivid",
        "noir"
      ]
    },
    "ColorGrade": {
      "type": "object",
      "additionalProperties": false,
      "description": "A preset expands to parameters in the renderer; explicit fields override it. Ranges are enforced at runtime (E_GRADE_RANGE).",
      "properties": {
        "preset": { "$ref": "#/$defs/GradePreset" },
        "exposure": { "type": "number", "description": "-2..2" },
        "contrast": { "type": "number", "description": "0.5..2" },
        "saturation": { "type": "number", "description": "0..2" },
        "temperature": { "type": "number", "description": "-1..1, blue → warm" },
        "tint": { "type": "number", "description": "-1..1, green → magenta" },
        "highlights": { "type": "number", "description": "-1..1" },
        "shadows": { "type": "number", "description": "-1..1" },
        "vibrance": { "type": "number", "description": "-1..1" },
        "lut": { "$ref": "#/$defs/LutPath" },
        "intensity": { "type": "number", "description": "0..1" }
      }
    },
    "SpeedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "speed"],
      "description": "A speed-ramp knot. Both values are range-checked at runtime (E_SPEED_RAMP).",
      "properties": {
        "t": { "type": "number" },
        "speed": { "type": "number" }
      }
    },
    "FormatRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "targetDurationSec"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "cinematic_hero",
            "social_hook",
            "room_walkthrough",
            "just_listed",
            "amenity_lifestyle",
            "price_drop",
            "agent_intro",
            "before_after",
            "drone_hero",
            "vertical_tour",
            "marketing_38"
          ]
        },
        "label": { "type": "string" },
        "targetDurationSec": { "type": "number", "minimum": 5, "maximum": 90 }
      }
    },
    "LookRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["calm", "social", "walkthrough", "editorial"]
        },
        "label": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "durationSec"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cut",
            "dissolve",
            "slide",
            "whip",
            "zoom_blur",
            "luma_wipe",
            "light_leak",
            "dip_black",
            "dip_white",
            "blur",
            "directional_blur",
            "push_left",
            "push_right",
            "circle",
            "wipe",
            "glitch"
          ]
        },
        "durationSec": { "type": "number", "minimum": 0, "maximum": 1.5 }
      }
    },
    "CropPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "x", "y", "scale"],
      "description": "Normalised crop window centre and zoom. t is relative to the clip (0..1).",
      "properties": {
        "t": { "type": "number", "minimum": 0, "maximum": 1 },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "scale": { "type": "number", "minimum": 1, "maximum": 2.5 }
      }
    },
    "Transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "focus", "path"],
      "description": "How a source clip fills the canvas. mode=cover crops; pad_blur letterboxes over a blurred fill; contain fits exactly.",
      "properties": {
        "mode": { "type": "string", "enum": ["cover", "pad_blur", "contain"] },
        "focus": {
          "type": "string",
          "enum": ["saliency", "center", "left", "right", "top", "bottom"]
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/CropPoint" }
        }
      }
    },
    "Clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "src", "inSec", "outSec", "speed", "volumeDb", "transform", "transitionIn", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^c[0-9]{2,3}$" },
        "sourceId": { "type": "string", "pattern": "^s_[a-f0-9]{8}$" },
        "src": {
          "type": "string",
          "description": "Path relative to the listing raw/ directory.",
          "minLength": 1
        },
        "inSec": { "type": "number", "minimum": 0 },
        "outSec": { "type": "number", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "volumeDb": { "type": "number", "minimum": -60, "maximum": 12 },
        "room": {
          "type": "string",
          "enum": [
            "exterior", "building", "entry", "living", "kitchen", "dining",
            "bedroom", "bathroom", "balcony", "view", "amenity", "unknown"
          ]
        },
        "transform": { "$ref": "#/$defs/Transform" },
        "transitionIn": { "$ref": "#/$defs/Transition" },
        "transitionOut": { "$ref": "#/$defs/Transition" },
        "handleOutSec": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5,
          "description": "Source seconds borrowed past outSec to feed the outgoing transition. Not part of the timeline."
        },
        "motionAtSelection": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Measured camera/subject motion on the selected shot, 0..1."
        },
        "reason": {
          "type": "string",
          "maxLength": 160,
          "description": "User-facing justification, plain language. Shown in the shot inspector."
        },
        "scoreAtSelection": { "type": "number", "minimum": 0, "maximum": 1 },
        "effects": {
          "type": "array",
          "maxItems": 20,
          "description": "v2: clip-scoped effects, applied before the clip grade.",
          "items": { "$ref": "#/$defs/Effect" }
        },
        "grade": {
          "$ref": "#/$defs/ColorGrade",
          "description": "v2: replaces the root grade for this clip."
        },
        "speedRamp": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "description": "v2: replaces the scalar speed. Requires speed === 1, first t = 0, last t = 1; the computed duration must match (outSec-inSec)/speed within 0.05s.",
          "items": { "$ref": "#/$defs/SpeedPoint" }
        }
      }
    },
    "OverlayFont": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string" },
        "weight": { "type": "number", "description": "100..900 (E_OVERLAY_KEYFRAME)" },
        "sizePx": { "type": "number" }
      }
    },
    "OverlayBackground": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "radiusPx": { "type": "number", "minimum": 0 }
      }
    },
    "OverlayKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t"],
      "description": "t is relative to the overlay window; x/y are 0..1 of the canvas.",
      "properties": {
        "t": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "type": "number" },
        "opacity": { "type": "number" },
        "rotation": { "type": "number" }
      }
    },
    "Overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "inSec", "outSec", "anchor", "style"],
      "properties": {
        "id": { "type": "string", "pattern": "^o[0-9]{2,3}$" },
        "kind": {
          "type": "string",
          "enum": ["price", "spec_row", "address", "logo", "lower_third", "cta", "disclaimer", "room_label"]
        },
        "text": { "type": "string", "maxLength": 90 },
        "subtext": { "type": "string", "maxLength": 90 },
        "inSec": { "type": "number", "minimum": 0 },
        "outSec": { "type": "number", "minimum": 0 },
        "anchor": {
          "type": "string",
          "enum": ["top_left", "top_center", "top_right", "center", "bottom_left", "bottom_center", "bottom_right"]
        },
        "style": {
          "type": "string",
          "enum": ["price_lower", "spec_pill", "address_tag", "logo_corner", "cta_card", "caption", "small_print"]
        },
        "maxWidthPct": { "type": "number", "minimum": 20, "maximum": 100 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "animation": {
          "type": "string",
          "enum": ["none", "fade", "rise", "slide_in", "count_up", "pop", "typewriter", "tracking_in", "blur_in", "scale_in"]
        },
        "exitAnimation": {
          "type": "string",
          "enum": ["none", "fade", "slide_out"]
        },
        "font": { "$ref": "#/$defs/OverlayFont" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "background": { "$ref": "#/$defs/OverlayBackground" },
        "rotation": { "type": "number", "description": "-180..180 (E_OVERLAY_KEYFRAME)" },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "description": "v2: t strictly increasing, all values in range (E_OVERLAY_KEYFRAME).",
          "items": { "$ref": "#/$defs/OverlayKeyframe" }
        }
      }
    },
    "CaptionFont": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string" },
        "weight": { "type": "number" },
        "sizePx": { "type": "number" },
        "uppercase": { "type": "boolean" }
      }
    },
    "CaptionBox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "opacity": { "type": "number" },
        "radiusPx": { "type": "number" }
      }
    },
    "CaptionPosition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "type": "string",
          "enum": ["bottom_center", "center", "top_center"]
        },
        "offsetPx": { "type": "number" }
      }
    },
    "CaptionHighlight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "words": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string" },
          "description": "Must be a subset of the words present in captions.words (E_CAPTION_STYLE)."
        }
      }
    },
    "Captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["burn", "sidecar", "both", "none"] },
        "style": {
          "type": "string",
          "enum": [
            "clean_lower",
            "bold_center",
            "editorial_serif",
            "social_bold",
            "clean_reel",
            "editorial"
          ]
        },
        "language": { "type": "string", "default": "en" },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "startSec", "endSec"],
            "properties": {
              "text": { "type": "string" },
              "startSec": { "type": "number", "minimum": 0 },
              "endSec": { "type": "number", "minimum": 0 }
            }
          }
        },
        "animation": {
          "type": "string",
          "enum": [
            "none",
            "fade",
            "rise",
            "slide_in",
            "pop",
            "typewriter",
            "word_by_word",
            "tracking_in",
            "blur_in",
            "scale_in"
          ]
        },
        "highlight": { "$ref": "#/$defs/CaptionHighlight" },
        "font": { "$ref": "#/$defs/CaptionFont" },
        "box": { "$ref": "#/$defs/CaptionBox" },
        "position": { "$ref": "#/$defs/CaptionPosition" },
        "maxWordsPerLine": {
          "type": "number",
          "description": "v2: 1..8, cue-builder default 6 (E_CAPTION_STYLE)."
        },
        "maxLines": {
          "type": "number",
          "description": "v2: 1..3, cue-builder default 2 (E_CAPTION_STYLE)."
        }
      }
    },
    "Music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackId", "src", "gainDb", "duckUnderVoiceDb", "beatGrid"],
      "properties": {
        "trackId": { "type": "string" },
        "src": { "type": "string" },
        "gainDb": { "type": "number", "minimum": -40, "maximum": 12 },
        "duckUnderVoiceDb": { "type": "number", "minimum": -30, "maximum": 0 },
        "beatGrid": {
          "type": "array",
          "maxItems": 2400,
          "items": { "type": "number", "minimum": 0 },
          "description": "Beat times in seconds, ascending. Cached per track so cuts snap without re-analysis."
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "licenseId"],
          "properties": {
            "source": { "type": "string", "enum": ["ai_generated", "royalty_free", "user_supplied"] },
            "licenseId": { "type": "string" },
            "attribution": { "type": "string" }
          }
        }
      }
    },
    "Voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["keep", "clean", "replace_tts", "mute"] },
        "src": { "type": "string" },
        "text": { "type": "string", "maxLength": 1200 },
        "voiceId": { "type": "string" },
        "enhance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "denoise": { "type": "boolean", "default": true },
            "dereverb": { "type": "boolean", "default": false },
            "isolate": { "type": "boolean", "default": false },
            "deess": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "Audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["music", "voice", "mix"],
      "properties": {
        "music": { "$ref": "#/$defs/Music" },
        "voice": { "$ref": "#/$defs/Voice" },
        "mix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lufs"],
          "properties": {
            "lufs": { "type": "number", "minimum": -30, "maximum": -8 },
            "truePeakDbtp": { "type": "number", "minimum": -3, "maximum": 0 }
          }
        },
        "fadeInSec": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "v2: music/voice fade-in, 0..5s."
        },
        "fadeOutSec": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "v2: music/voice fade-out, 0..5s."
        }
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "checks"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed", "detail"],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "duration", "no_black_frames", "no_freeze", "text_safe_area",
                  "cta_legible", "room_order", "loudness", "no_repeated_shot",
                  "hook_visible", "facts_present", "marketing_beats"
                ]
              },
              "passed": { "type": "boolean" },
              "detail": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "reviewedBy": { "type": "string" }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipelineVersion", "models", "promptVersions", "costUsd"],
      "properties": {
        "pipelineVersion": { "type": "string" },
        "sourceIndexHash": {
          "type": "string",
          "description": "Hash of the footage index this plan was built from. Mismatch invalidates the plan."
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tagging", "planning"],
          "properties": {
            "tagging": { "type": "string" },
            "planning": { "type": "string" },
            "review": { "type": "string" },
            "tts": { "type": "string" }
          }
        },
        "promptVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tagging", "planning"],
          "properties": {
            "tagging": { "type": "string" },
            "planning": { "type": "string" }
          }
        },
        "costUsd": { "type": "number", "minimum": 0 },
        "renderCacheHits": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
